{
  "name": "sessionbay",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run tauri -- dev",
    "dev:web": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "typecheck": "tsc -b",
    "test": "vitest run && node --test src-tauri/src/claude_state_mod.contract.mjs src-tauri/src/opencode_state_plugin.contract.mjs",
    "test:watch": "vitest",
    "lint": "eslint src",
    "tauri": "node scripts/tauri.mjs",
    "test:files": "playwright test --config playwright.files.config.ts",
    "test:images": "playwright test --config playwright.images.config.ts",
    "test:agent-status": "playwright test --config playwright.agent-status.config.ts",
    "test:tabs": "playwright test --config playwright.tabs.config.ts",
    "test:layout": "playwright test --config playwright.layout.config.ts",
    "test:flicker": "playwright test --config playwright.flicker.config.ts",
    "test:interactions": "playwright test --config playwright.interactions.config.ts",
    "test:sidebar": "playwright test --config playwright.sidebar.config.ts",
    "test:ime": "playwright test --config playwright.ime.config.ts",
    "test:focus-mode": "playwright test --config playwright.focus-mode.config.ts",
    "test:git": "playwright test --config playwright.git.config.ts"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "2.8.3",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-search": "0.16.0",
    "@xterm/xterm": "6.0.0",
    "lucide-react": "^0.468.0",
    "monaco-editor": "0.57.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@playwright/test": "1.56.1",
    "@tauri-apps/cli": "^2.9.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "24.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.18.0",
    "vite": "^6.0.5",
    "vitest": "^5.0.4"
  }
}
