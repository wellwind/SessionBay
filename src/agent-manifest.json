{
  "version": 1,
  "providers": [
    {
      "id": "codex",
      "name": "Codex",
      "executable": "codex",
      "logo": "C",
      "bypassFlag": "--dangerously-bypass-approvals-and-sandbox",
      "history": {
        "supported": true,
        "sourceEnv": "CODEX_HOME",
        "rootPlaceholder": "/Users/you/.codex",
        "description": "唯讀索引 Codex 本機歷史，支援搜尋、預覽與接續工作。",
        "parserId": "codex",
        "defaultDirectory": ".codex",
        "probeDirectory": null
      },
      "resume": {
        "manualId": false,
        "argument": "resume",
        "description": "從已索引的歷史接續，使用 codex resume。"
      },
      "launch": {
        "versionArgs": [
          "--version"
        ],
        "newArgs": [],
        "resumeArgs": [
          "resume",
          "{resumeId}"
        ],
        "cwdArgs": [
          "--cd",
          "{cwd}"
        ]
      },
      "activity": {
        "adapter": "codexHooks",
        "transport": "orderedBridgeOptIn"
      }
    },
    {
      "id": "claude",
      "name": "Claude Code",
      "executable": "claude",
      "logo": "✳",
      "bypassFlag": "--dangerously-skip-permissions",
      "history": {
        "supported": true,
        "sourceEnv": "CLAUDE_CONFIG_DIR",
        "rootPlaceholder": "/Users/you/.claude",
        "description": "唯讀索引 Claude Code 本機歷史，支援搜尋、預覽與接續工作。",
        "parserId": "claude",
        "defaultDirectory": ".claude",
        "probeDirectory": null
      },
      "resume": {
        "manualId": false,
        "argument": "--resume",
        "description": "從已索引的歷史接續，使用 claude --resume。"
      },
      "launch": {
        "versionArgs": [
          "--version"
        ],
        "newArgs": [],
        "resumeArgs": [
          "--resume",
          "{resumeId}"
        ],
        "cwdArgs": []
      },
      "activity": {
        "adapter": "claudeHooks",
        "transport": "orderedBridgeOptIn"
      }
    },
    {
      "id": "grok",
      "name": "Grok Build",
      "executable": "grok",
      "logo": "G",
      "bypassFlag": "--always-approve",
      "history": {
        "supported": true,
        "sourceEnv": "GROK_HOME",
        "rootPlaceholder": "/Users/you/.grok",
        "description": "唯讀索引 Grok Build 本機歷史，支援搜尋、預覽與接續工作。",
        "parserId": "grok",
        "defaultDirectory": ".grok",
        "probeDirectory": "sessions"
      },
      "resume": {
        "manualId": true,
        "argument": "--resume",
        "description": "可從歷史接續或指定對話 ID；使用 --resume，不使用建立新對話的 --session-id。"
      },
      "launch": {
        "versionArgs": [
          "version"
        ],
        "newArgs": [],
        "resumeArgs": [
          "--resume",
          "{resumeId}"
        ],
        "cwdArgs": []
      },
      "activity": {
        "adapter": "grokHooks",
        "transport": "orderedBridgeOptIn"
      }
    },
    {
      "id": "antigravity",
      "name": "Antigravity CLI",
      "executable": "agy",
      "logo": "A",
      "bypassFlag": "--dangerously-skip-permissions",
      "history": {
        "supported": true,
        "sourceEnv": null,
        "rootPlaceholder": "/Users/you/.gemini/antigravity-cli",
        "description": "CLI 歷史讀取（相容性驗證中）：本機 metadata 與持久化 transcript；1.3.5 真實磁碟樣本尚待驗證。不包含 App／IDE，未知或截斷格式會顯示警告。",
        "parserId": "antigravity",
        "defaultDirectory": ".gemini/antigravity-cli",
        "probeDirectory": "brain"
      },
      "resume": {
        "manualId": true,
        "argument": "--conversation",
        "description": "可開始新工作，或指定對話 ID，以 agy --conversation 接續。"
      },
      "launch": {
        "versionArgs": [
          "--version"
        ],
        "newArgs": [],
        "resumeArgs": [
          "--conversation",
          "{resumeId}"
        ],
        "cwdArgs": []
      },
      "activity": {
        "adapter": "antigravityHooks",
        "transport": "orderedBridgeOptIn"
      }
    },
    {
      "id": "opencode",
      "name": "OpenCode",
      "executable": "opencode",
      "logo": "O",
      "bypassFlag": "--auto",
      "history": {
        "supported": true,
        "sourceEnv": null,
        "rootPlaceholder": "/Users/you/.local/share/opencode",
        "description": "唯讀讀取來源目錄內 opencode.db（依官方 v1.19.2／1.19.3 結構）；支援搜尋、預覽與 --session 接續。舊 JSON 與自訂 DB 檔名尚未支援；Linux 已以真實 CLI 1.19.2／1.19.3 寫入的資料庫驗收。",
        "parserId": "opencode",
        "defaultDirectory": ".local/share/opencode",
        "probeDirectory": null
      },
      "resume": {
        "manualId": true,
        "argument": "--session",
        "description": "以 opencode --session 接續指定對話；不使用 --continue 猜測或 --fork 複製。"
      },
      "launch": {
        "versionArgs": [
          "--version"
        ],
        "newArgs": [],
        "resumeArgs": [
          "--session",
          "{resumeId}"
        ],
        "cwdArgs": []
      },
      "activity": {
        "adapter": "openCodeV1Events",
        "transport": "orderedBridgeOptIn"
      }
    }
  ]
}
