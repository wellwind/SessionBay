{
  "version": 1,
  "providers": [
    {
      "id": "codex",
      "name": "Codex",
      "executable": "codex",
      "logo": "C",
      "bypassFlag": "--dangerously-bypass-approvals-and-sandbox",
      "history": {
        "supported": true,
        "sourceEnv": "CODEX_HOME",
        "rootPlaceholder": "/Users/you/.codex",
        "description": "Read-only index of local Codex history, with search, preview and resume.",
        "parserId": "codex",
        "defaultDirectory": ".codex",
        "probeDirectory": null
      },
      "resume": {
        "manualId": false,
        "argument": "resume",
        "description": "Resumes from indexed history with codex resume."
      },
      "launch": {
        "versionArgs": [
          "--version"
        ],
        "newArgs": [],
        "resumeArgs": [
          "resume",
          "{resumeId}"
        ],
        "cwdArgs": [
          "--cd",
          "{cwd}"
        ]
      },
      "activity": {
        "adapter": "codexHooks",
        "transport": "orderedBridgeOptIn"
      }
    },
    {
      "id": "claude",
      "name": "Claude Code",
      "executable": "claude",
      "logo": "✳",
      "bypassFlag": "--dangerously-skip-permissions",
      "history": {
        "supported": true,
        "sourceEnv": "CLAUDE_CONFIG_DIR",
        "rootPlaceholder": "/Users/you/.claude",
        "description": "Read-only index of local Claude Code history, with search, preview and resume.",
        "parserId": "claude",
        "defaultDirectory": ".claude",
        "probeDirectory": null
      },
      "resume": {
        "manualId": false,
        "argument": "--resume",
        "description": "Resumes from indexed history with claude --resume."
      },
      "launch": {
        "versionArgs": [
          "--version"
        ],
        "newArgs": [],
        "resumeArgs": [
          "--resume",
          "{resumeId}"
        ],
        "cwdArgs": []
      },
      "activity": {
        "adapter": "claudeHooks",
        "transport": "orderedBridgeOptIn"
      }
    },
    {
      "id": "grok",
      "name": "Grok Build",
      "executable": "grok",
      "logo": "G",
      "bypassFlag": "--always-approve",
      "history": {
        "supported": true,
        "sourceEnv": "GROK_HOME",
        "rootPlaceholder": "/Users/you/.grok",
        "description": "Read-only index of local Grok Build history, with search, preview and resume.",
        "parserId": "grok",
        "defaultDirectory": ".grok",
        "probeDirectory": "sessions"
      },
      "resume": {
        "manualId": true,
        "argument": "--resume",
        "description": "Resume from history or by conversation ID, using --resume (not --session-id, which creates a new conversation)."
      },
      "launch": {
        "versionArgs": [
          "version"
        ],
        "newArgs": [],
        "resumeArgs": [
          "--resume",
          "{resumeId}"
        ],
        "cwdArgs": []
      },
      "activity": {
        "adapter": "grokHooks",
        "transport": "orderedBridgeOptIn"
      }
    },
    {
      "id": "antigravity",
      "name": "Antigravity CLI",
      "executable": "agy",
      "logo": "A",
      "bypassFlag": "--dangerously-skip-permissions",
      "history": {
        "supported": true,
        "sourceEnv": null,
        "rootPlaceholder": "/Users/you/.gemini/antigravity-cli",
        "description": "CLI history reading (compatibility being verified): local metadata and persisted transcripts; real 1.3.5 samples are not verified yet. The app and IDE are not included; unknown or truncated formats show a warning.",
        "parserId": "antigravity",
        "defaultDirectory": ".gemini/antigravity-cli",
        "probeDirectory": "brain"
      },
      "resume": {
        "manualId": true,
        "argument": "--conversation",
        "description": "Start new work, or resume a conversation ID with agy --conversation."
      },
      "launch": {
        "versionArgs": [
          "--version"
        ],
        "newArgs": [],
        "resumeArgs": [
          "--conversation",
          "{resumeId}"
        ],
        "cwdArgs": []
      },
      "activity": {
        "adapter": "antigravityHooks",
        "transport": "orderedBridgeOptIn"
      }
    },
    {
      "id": "opencode",
      "name": "OpenCode",
      "executable": "opencode",
      "logo": "O",
      "bypassFlag": "--auto",
      "history": {
        "supported": true,
        "sourceEnv": null,
        "rootPlaceholder": "/Users/you/.local/share/opencode",
        "description": "Reads opencode.db in the source folder read-only (official v1.19.2 / 1.19.3 schema), with search, preview and --session resume. The old JSON storage and custom database names are not supported yet; verified on Linux with databases written by the real CLI 1.19.2 / 1.19.3.",
        "parserId": "opencode",
        "defaultDirectory": ".local/share/opencode",
        "probeDirectory": null
      },
      "resume": {
        "manualId": true,
        "argument": "--session",
        "description": "Resumes the chosen conversation with opencode --session; never guesses with --continue or copies with --fork."
      },
      "launch": {
        "versionArgs": [
          "--version"
        ],
        "newArgs": [],
        "resumeArgs": [
          "--session",
          "{resumeId}"
        ],
        "cwdArgs": []
      },
      "activity": {
        "adapter": "openCodeV1Events",
        "transport": "orderedBridgeOptIn"
      }
    }
  ]
}
